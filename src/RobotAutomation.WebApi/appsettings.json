{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4201", "http://localhost:4200" ]
  },
  "Playwright": {
    "Headless": false,
    "SlowMoMs": 150,
    "DefaultTimeoutMs": 15000,
    "RunTimeoutMs": 900000,
    "MaxConcurrentRuns": 4,
    "MaxStepRetries": 2,
    "ScreenshotDirectory": null
  },
  "Bridge": {
    "ExecutablePath": "C:\\Users\\GENERAFI\\code\\generafi_tva\\GeneraFi.Robot.Bridge\\bin\\Debug\\GeneraFi.Robot.Bridge.exe",
    "TimeoutMs": 120000,
    "EdiDirectory": "%APPDATA%\\GeneraFi\\GeneraFi_TVA\\Declarations"
  },
  "DgiPortals": {
    "fake": {
      "BaseUrl": "http://localhost:4201/",
      "InitialRoute": "#/dgi/login",
      "NavigationWaitUntil": "DOMContentLoaded",
      "Selectors": {
        "UsernameInput": "#username",
        "PasswordInput": "#password",
        "CaptchaChallenge": ".dgi__captcha-code",
        "CaptchaInput": "#captcha",
        "SubmitButton": "button[type=submit]",
        "SuccessIndicator": "#login-success"
      },
      "SuccessRule": {
        "Mode": "SelectorVisible"
      },
      "Elements": {
        "menuDeclaration": "#menu-declaration",
        "menuProduits": "#menu-produits",
        "regimeSelect": "#regime",
        "moisSelect": "#mois",
        "anneeSelect": "#annee",
        "createPeriodButton": "#create-period",
        "ediFileInput": "#edi-file",
        "caTotalInput": "#ca-total",
        "tvaExigibleInput": "#tva-exigible",
        "tvaDeductibleInput": "#tva-deductible",
        "submitDeclarationButton": "#submit-declaration",
        "declarationSuccessIndicator": "#declaration-success",
        "addProductButton": "#add-product",
        "productRowPrefix": "[data-row='{i}']",
        "productDesignation": ".product-designation",
        "productPays": ".product-pays",
        "productValeur": ".product-valeur",
        "productTaux": ".product-taux",
        "productMontant": ".product-montant",
        "submitProductsButton": "#submit-products",
        "productsSuccessIndicator": "#products-success"
      }
    },
    "real": {
      "BaseUrl": "https://tva.tax.gov.ma/tva/",
      "InitialRoute": "#/login",
      "NavigationWaitUntil": "NetworkIdle",
      "CaptchaMode": "Manual",
      "ManualInputTimeoutMs": 300000,
      "ReuseSession": true,
      "MaxDeclarationDeletions": 1,
      "Selectors": {
        "UsernameInput": "#login",
        "PasswordInput": "#password",
        "CaptchaChallenge": "img[alt='Captcha']",
        "CaptchaInput": "#captcha",
        "SubmitButton": "button.c-button--main--submit",
        "SuccessIndicator": "app-codeacces"
      },
      "SuccessRule": {
        "Mode": "SelectorVisible",
        "HiddenSelector": "app-login",
        "ContentSelector": ""
      },
      "Elements": {
        "otpInput": "#codeAcces",

        "dialog": ".swal2-container .swal2-popup",
        "dialogTitle": ".swal2-container .swal2-title",
        "dialogContent": ".swal2-container .swal2-html-container",
        "dialogConfirm": ".swal2-container button.swal2-confirm",
        "dialogError": ".swal2-container .swal2-icon.swal2-error",
        "loader": "",

        "declarationsTable": "ng2-smart-table table",
        "declarationRow": "ng2-smart-table tbody tr:has(i.fa-remove)",
        "declarationDeleteButton": "ng2-smart-table tbody tr i.fa-remove",
        "declarationDeleteConfirmText": "supprimer",

        "menuToggle": "app-menu .js-open-menu",
        "menuDeclarationGroup": "app-menu nav > ul > li:has(a[href='#/dec-tva']) > a",
        "menuDeclarationCurrentPeriod": "app-menu a[href='#/dec-tva']",
        "menuEdiGroup": "app-menu nav > ul > li:has(a[href='#/envoiEdi']) > a",
        "menuEdiSend": "app-menu a[href='#/envoiEdi']",
        "declarationPageUrl": "**/#/dec-tva",
        "ediPageUrl": "**/#/envoiEdi",

        "declarationRegime": "Mensuel",
        "declarationRegimeSelect": "app-create-declaration select",
        "declarationCreateButton": "app-create-declaration input[type='submit']",
        "declarationEditUrl": "**/#/dec-tva/edit/*",
        "declarationSaveButton": "#enregistrer",
        "declarationRecalculateButton": "#recalculateId",

        "declarationForm": "app-edit-declaration",
        "declarationFaitGenerateur": "app-edit-declaration > div.grid select",
        "declarationProrataInput": "",
        "declarationCollapsedSection": "app-edit-declaration .fields__grp__title:not(.opened)",
        "declarationCollapsedTab": "app-edit-declaration app-tab label.container:has(span.checkmark:not(.open))",
        "declarationLineRow": "//app-edit-declaration//tr[number(normalize-space(td[1]))={code}]",
        "declarationLineAmounts": "//input[@type='number']",

        "ediFileInput": "app-envoi-edi input[type='file']",
        "ediUploadButton": "app-envoi-edi input[type='submit']",

        "declarationEditRow": "ng2-smart-table tbody tr:has-text('{id}')",
        "declarationEditButton": "i:is(.fa-edit, .fa-pencil, .fa-pencil-square-o)",
        "declarationEditRoute": "#/dec-tva/edit/{id}"
      }
    },
    "rdv": {
      "BaseUrl": "https://tax.rdv.gov.ma/",
      "InitialRoute": "?page=citoyen.Accueil",
      "NavigationWaitUntil": "Load",
      "ReadySelector": "a:has-text('Prendre un rendez-vous')",
      "StopBeforeFinalSubmit": true,
      "Selectors": {},
      "SuccessRule": { "Mode": "SelectorVisible" },
      "Elements": {
        "takeAppointmentLink": "a:has-text('Prendre un rendez-vous')",
        "loader": "#bloc-loader",
        "regionSelect": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_entite1",
        "directionSelect": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_etablissement",
        "natureSelect": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_typePrestation",
        "vousEtesSelect": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_prestation",
        "lieuImpositionSelect": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_ressource",
        "cguCheckbox": "#ctl0_CONTENU_PAGE_gestionRdv_choixPrestation_conditions",
        "nextStepButton": "#ctl0_CONTENU_PAGE_gestionRdv_etapeSuivante",
        "availableDate": "#datepicker td[data-handler='selectDay'] a",
        "timeSlot": "#availableTime a.btn-mini",
        "iceInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_raisonSocial",
        "identifiantFiscalInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_identifiant",
        "raisonSocialeInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_nom",
        "adresseInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_adresse",
        "emailInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_email",
        "telephoneInput": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_telephone",
        "confirmButton": "#ctl0_CONTENU_PAGE_gestionRdv_btnSave",
        "confirmationReady": "",
        "confNumber": "",
        "confDate": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_dateRdv",
        "confDirection": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_nomEtab",
        "confNature": "#ctl0_CONTENU_PAGE_gestionRdv_formCitoyen_typePrestation"
      }
    }
  }
}
